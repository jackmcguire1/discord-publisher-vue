# `yarn dev` and the e2e suite talk to the local emulators (`yarn emulators`).
# A "demo-" project id guarantees nothing can reach a real Firebase project.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-discord-publisher
VITE_FIREBASE_EMULATORS=true
