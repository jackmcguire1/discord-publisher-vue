{
  "name": "discord-publisher-vue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "emulators": "mkdir -p .emulator-data && firebase emulators:start --project demo-discord-publisher --import .emulator-data --export-on-exit",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "firebase emulators:exec --project demo-discord-publisher --only auth,firestore \"start-server-and-test dev:test http://localhost:5180 'cypress run'\"",
    "test:open": "start-server-and-test dev:test http://localhost:5180 'cypress open'",
    "test:rules": "firebase emulators:exec --project demo-discord-publisher --only firestore \"node --test tests/rules/*.test.mjs\"",
    "dev:test": "vite --port 5180 --strictPort",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase": "13.0.0",
    "highlight.js": "11.12.0",
    "simple-markdown": "^0.7.3",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "cypress": "^16.2.0",
    "firebase-tools": "^15.34.0",
    "start-server-and-test": "^3.0.13",
    "typescript": "~6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
