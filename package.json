    "dev:test": "vite --port 5180 --strictPort"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "simple-markdown": "^0.7.3",
    "vue": "3.5.43",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@vitejs/plugin-vue": "6.0.9",
    "cypress": "^16.1.1",
    "start-server-and-test": "^3.0.12",
    "typescript": "~6.0.3",
    "vite": "8.3.2",
    "vue-tsc": "3.3.11"
  }
}
