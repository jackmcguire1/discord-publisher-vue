{
  "name": "discord-publisher-vue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "start-server-and-test dev:test http://localhost:5180 'cypress run'",
    "test:open": "start-server-and-test dev:test http://localhost:5180 'cypress open'",
    "dev:test": "vite --port 5180 --strictPort"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "simple-markdown": "^0.7.3",
    "vue": "^3.5.13",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "cypress": "^16.1.1",
    "start-server-and-test": "^3.0.12",
    "typescript": "~7.0.2",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.8"
  }
}
