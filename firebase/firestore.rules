rules_version = '2';

// Data model
//   orgs/{orgId}                    { name, ownerUid, createdAt, deleting? }
//   orgs/{orgId}/members/{uid}      { uid, email, role: owner|admin|member, joinedAt, canPublish?, canDelete? }
//   orgs/{orgId}/invites/{email}    { email, role: admin|member, orgName, invitedBy, createdAt, canPublish?, canDelete? }
//   orgs/{orgId}/servers/{id}       admins write, members read
//   orgs/{orgId}/webhooks/{id}      admins write, members read (holds the webhook token)
//   orgs/{orgId}/authors/{id}       members read/write
//   orgs/{orgId}/drafts/{id}        messages: drafts, published (`published`) and deleted from Discord (`deleted`)
//     .../revisions/{revId}         { number, kind: saved|published|updated, message, createdAt, createdBy, note? }, immutable
//
// Permissions: owners and admins can do everything. Members carry two flags:
// canPublish (default true) to publish and update messages on Discord, and
// canDelete (default false) to delete them from Discord or remove a published
// or deleted message from the org. Plain drafts are open to every member.
// Discord itself is called from the browser, so these rules govern the org's
// records of messages, not Discord.
//
// Everything is scoped to an org. Users join by creating an org (becoming its
// owner) or by accepting an invite addressed to their verified email.
//
// Transferring ownership: the owner, in one batch, sets the org's ownerUid to
// another member, makes that member `owner` and makes themselves `admin`. The
// rules only accept all three together, so there is always exactly one owner.
//
// Deleting an org: Firestore doesn't cascade, so an admin first sets
// `deleting: true`, removes the subcollections (other members included), then
// deletes the org doc, then their own membership last.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function orgPath(orgId) {
      return /databases/$(database)/documents/orgs/$(orgId);
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid);
    }

    function isMember(orgId) {
      return signedIn() && exists(memberPath(orgId));
    }

    function role(orgId) {
      return get(memberPath(orgId)).data.role;
    }

    function isAdmin(orgId) {
      return isMember(orgId) && role(orgId) in ['owner', 'admin'];
    }

    function perm(orgId, key, fallback) {
      return isAdmin(orgId) || (isMember(orgId) && get(memberPath(orgId)).data.get(key, fallback) == true);
    }

    function canPublish(orgId) {
      return perm(orgId, 'canPublish', true);
    }

    function canDelete(orgId) {
      return perm(orgId, 'canDelete', false);
    }

    function field(data, name) {
      return data.get(name, null);
    }

    function validPerms(data) {
      return data.get('canPublish', true) is bool && data.get('canDelete', false) is bool;
    }

    function invitePath(orgId) {
      return /databases/$(database)/documents/orgs/$(orgId)/invites/$(myEmail());
    }

    function isOwner(orgId) {
      return isMember(orgId) && role(orgId) == 'owner';
    }

    function memberAfter(orgId, uid) {
      return getAfter(/databases/$(database)/documents/orgs/$(orgId)/members/$(uid)).data;
    }

    function isDeleting(orgId) {
      return exists(orgPath(orgId)) && get(orgPath(orgId)).data.get('deleting', false) == true;
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function shortString(v, max) {
      return v is string && v.size() <= max;
    }

    // A user's own memberships and invites, across all orgs (collection group queries).
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /{path=**}/invites/{inviteId} {
      allow read: if verified() && resource.data.email == myEmail();
    }

    match /orgs/{orgId} {
      allow read: if isMember(orgId);
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && shortString(request.resource.data.name, 100)
        && request.resource.data.name.size() > 0;
      allow update: if isAdmin(orgId) && (
        (onlyChanges(['name'])
          && shortString(request.resource.data.name, 100)
          && request.resource.data.name.size() > 0)
        || (onlyChanges(['deleting']) && request.resource.data.deleting == true)
      )
      // Ownership transfer, with both membership changes in the same batch.
      || (isOwner(orgId)
        && onlyChanges(['ownerUid'])
        && request.resource.data.ownerUid != request.auth.uid
        && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.resource.data.ownerUid))
        && memberAfter(orgId, request.resource.data.ownerUid).role == 'owner'
        && memberAfter(orgId, request.auth.uid).role == 'admin');
      allow delete: if isAdmin(orgId) && resource.data.get('deleting', false) == true;

      match /members/{uid} {
        allow read: if isMember(orgId);

        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'email', 'role', 'joinedAt', 'canPublish', 'canDelete'])
          && request.resource.data.uid == uid
          && request.resource.data.email == myEmail()
          && (
            // The creator becomes owner in the same batch that creates the org.
            (request.resource.data.role == 'owner'
              && !exists(orgPath(orgId))
              && getAfter(orgPath(orgId)).data.ownerUid == request.auth.uid)
            ||
            // Accepting an invite addressed to this (verified) email, with exactly the invited role and permissions.
            (verified()
              && exists(invitePath(orgId))
              && get(invitePath(orgId)).data.role == request.resource.data.role
              && get(invitePath(orgId)).data.get('canPublish', true) == request.resource.data.get('canPublish', true)
              && get(invitePath(orgId)).data.get('canDelete', false) == request.resource.data.get('canDelete', false))
          );

        // Admins can switch others between admin and member and set their
        // permissions; the owner's role is fixed.
        allow update: if (isAdmin(orgId)
          && uid != request.auth.uid
          && resource.data.role != 'owner'
          && onlyChanges(['role', 'canPublish', 'canDelete'])
          && request.resource.data.role in ['admin', 'member']
          && validPerms(request.resource.data))
          // Ownership transfer: the owner promotes another member...
          || (isOwner(orgId)
            && uid != request.auth.uid
            && onlyChanges(['role'])
            && request.resource.data.role == 'owner'
            && getAfter(orgPath(orgId)).data.ownerUid == uid
            && memberAfter(orgId, request.auth.uid).role == 'admin')
          // ...and steps down to admin in the same batch.
          || (isOwner(orgId)
            && uid == request.auth.uid
            && onlyChanges(['role'])
            && request.resource.data.role == 'admin'
            && getAfter(orgPath(orgId)).data.ownerUid != uid
            && memberAfter(orgId, getAfter(orgPath(orgId)).data.ownerUid).role == 'owner');

        // Admins remove others; anyone but the owner can leave. While an org is
        // being deleted admins may remove anyone, and once the org doc is gone
        // each user may remove their own leftover membership.
        allow delete: if (resource.data.role != 'owner' && (uid == request.auth.uid || isAdmin(orgId)))
          || (isAdmin(orgId) && isDeleting(orgId))
          || (uid == request.auth.uid && !exists(orgPath(orgId)));
      }

      match /invites/{inviteEmail} {
        allow read: if isMember(orgId) || (verified() && inviteEmail == myEmail());
        allow create, update: if isAdmin(orgId)
          && request.resource.data.keys().hasOnly(['email', 'role', 'orgName', 'invitedBy', 'createdAt', 'canPublish', 'canDelete'])
          && validPerms(request.resource.data)
          && request.resource.data.email == inviteEmail
          && inviteEmail == inviteEmail.lower()
          && shortString(inviteEmail, 320)
          && request.resource.data.role in ['admin', 'member']
          && request.resource.data.invitedBy == request.auth.uid
          && shortString(request.resource.data.orgName, 100);
        // Admins revoke; the invitee removes it when accepting or declining.
        allow delete: if isAdmin(orgId) || (verified() && inviteEmail == myEmail());
      }

      match /servers/{id} {
        allow read: if isMember(orgId);
        allow create, update: if isAdmin(orgId)
          && shortString(request.resource.data.name, 100)
          && shortString(request.resource.data.guildId, 32);
        allow delete: if isAdmin(orgId);
      }

      match /webhooks/{id} {
        allow read: if isMember(orgId);
        allow create, update: if isAdmin(orgId)
          && shortString(request.resource.data.name, 100)
          && shortString(request.resource.data.description, 500)
          && request.resource.data.url is string
          && request.resource.data.url.matches('^https?://((canary|ptb)[.])?discord(app)?[.]com/api(/v[0-9]+)?/webhooks/[0-9]+/[A-Za-z0-9_-]+$');
        allow delete: if isAdmin(orgId);
      }

      match /authors/{id} {
        allow read, delete: if isMember(orgId);
        allow create, update: if isMember(orgId)
          && shortString(request.resource.data.name, 256)
          && shortString(request.resource.data.url, 2048)
          && shortString(request.resource.data.avatarUrl, 2048);
      }

      match /drafts/{id} {
        function validMessage() {
          return shortString(request.resource.data.name, 200) && request.resource.data.message is map;
        }

        allow read: if isMember(orgId);

        allow create: if isMember(orgId) && validMessage()
          && (field(request.resource.data, 'published') == null || canPublish(orgId))
          && (field(request.resource.data, 'deleted') == null || canDelete(orgId));

        // Publishing or updating on Discord changes `published`; deleting from
        // Discord clears it and sets `deleted`.
        allow update: if isMember(orgId) && validMessage()
          && (field(request.resource.data, 'deleted') == field(resource.data, 'deleted') || canDelete(orgId))
          && (field(request.resource.data, 'published') == field(resource.data, 'published')
            || (field(request.resource.data, 'published') == null && canDelete(orgId))
            || (field(request.resource.data, 'published') != null && canPublish(orgId)));

        // Plain drafts can be removed by any member; published or deleted messages are history.
        allow delete: if isMember(orgId)
          && ((field(resource.data, 'published') == null && field(resource.data, 'deleted') == null) || canDelete(orgId));

        // Snapshots of the message. Anyone in the org records "saved" ones;
        // "published"/"updated" ones need canPublish. They are never edited.
        // Any member may delete a "saved" one; the record of what went out to
        // Discord only goes when its message is removed (same permission as the message).
        match /revisions/{revId} {
          function draftDoc() {
            return /databases/$(database)/documents/orgs/$(orgId)/drafts/$(id);
          }

          allow read: if isMember(orgId);
          allow create: if isMember(orgId)
            && request.resource.data.keys().hasOnly(['number', 'kind', 'message', 'createdAt', 'createdBy', 'note'])
            && request.resource.data.number is int
            && request.resource.data.message is map
            && request.resource.data.createdAt is string
            && request.resource.data.get('createdBy', myEmail()) == myEmail()
            && (request.resource.data.kind == 'saved'
              || (request.resource.data.kind in ['published', 'updated'] && canPublish(orgId)));
          allow update: if false;
          allow delete: if isMember(orgId) && (
            resource.data.kind == 'saved'
            || canDelete(orgId)
            || !exists(draftDoc())
            || (get(draftDoc()).data.get('published', null) == null && get(draftDoc()).data.get('deleted', null) == null)
          );
        }
      }
    }
  }
}
